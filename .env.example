# Copy to .env.local and adjust

# Postgres (required for auth + app data in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_copilot

# Auth.js — min 32 characters (openssl rand -base64 32)
AUTH_SECRET=development-secret-min-32-characters-long

# OpenAI for "Corriger avec l'IA"
OPENAI_API_KEY=

# Optional Google OAuth (Auth.js) — configure redirect URI for this app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Gemini (future models)
GEMINI_API_KEY=

# Optional: Sentry
SENTRY_DSN=

# Inngest (local dev uses Inngest Dev Server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Dev without Postgres: set to "memory"
# AUDIT_STORE=memory

# Behind a trusted reverse proxy (Vercel, nginx): enable to use X-Forwarded-For
# TRUST_PROXY=1

# Optional Upstash Redis — Marketplace injects KV_REST_API_URL + KV_REST_API_TOKEN
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional PageSpeed Insights API key (higher quota). Works without key with IP limits.
# PAGESPEED_API_KEY=
